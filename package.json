{
	"name": "new-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#data/*": "./src/data/*",
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "node scripts/sync-cv.mjs && vite dev",
		"build": "node scripts/sync-cv.mjs && vite build",
		"preview": "vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "node scripts/sync-cv.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "node scripts/sync-cv.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"brand:sync": "cp ../samizdata/brand/css/tokens.css src/styles/vendor/samizdata/tokens.css",
		"brand:check": "cmp ../samizdata/brand/css/tokens.css src/styles/vendor/samizdata/tokens.css",
		"cv:sync": "node scripts/sync-cv.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"wrangler": "4.162.0"
	},
	"dependencies": {
		"@fontsource/space-grotesk": "^5.3.0",
		"@fontsource/work-sans": "^5.3.0",
		"svelte-bootstrap-icons": "^3.3.0"
	}
}
