{
	"name": "new-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"brand:sync": "cp ../samizdata/brand/css/tokens.css src/styles/vendor/samizdata/tokens.css",
		"brand:check": "cmp ../samizdata/brand/css/tokens.css src/styles/vendor/samizdata/tokens.css"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.6",
		"typescript": "^5.9.3",
		"vite": "^8.1.3"
	},
	"dependencies": {
		"svelte-bootstrap-icons": "^3.3.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"cookie": "^1.0.2"
		}
	}
}
